index 2b6877a..5f6fc58 100644
--- a/src/uni/uni.c
+++ b/src/uni/uni.c
@@ -133,3 +133,73 @@ int uni_width(const unsigned char *s, size_t n, size_t i)
 		return 2;
 	return w == 0 ? 1 : w == 1 ? 2 : w == 2 ? 4 : 6;
 }
+
+/* utf_ptr2len_len(s + j, m - j): Neovim's step, whose table still reads 5-
+   and 6-byte sequences, and which takes a sequence that m cuts off whole when
+   the bytes before m are continuation bytes */
+/*@ requires 0 <= j < m && \valid_read(s + (j .. m - 1));
+    assigns \nothing;
+    ensures \result == vstep(s, m, j) && 1 <= \result <= 6;
+*/
+static size_t step(const unsigned char *s, size_t m, size_t j)
+{
+	unsigned char c = s[j];
+	size_t t = c < 0xC0 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : c < 0xF8 ? 4 : c < 0xFC ? 5 : c < 0xFE ? 6 : 1;
+	//@ assert t == vlen(c);
+	/*@ loop invariant 1 <= k <= t;
+	    loop invariant \forall integer q; 1 <= q < k ==> cont(s[j + q]);
+	    loop assigns k;
+	    loop variant t - k; */
+	for (size_t k = 1; k < t && k < m - j; k++)
+		if (s[j + k] < 0x80 || s[j + k] >= 0xC0) return 1;
+	return t;
+}
+
+/* UTF-16 units of the step at j: 2 when utf_ptr2char() decodes a whole
+   sequence above U+FFFF (mb_utflen()) */
+/*@ requires 0 <= j < n && \valid_read(s + (0 .. n - 1));
+    assigns \nothing;
+    ensures \result == vunits(s, n, j);
+*/
+static size_t units(const unsigned char *s, size_t n, size_t j)
+{
+	size_t t = step(s, n, j);
+	if (t < 4 || t > n - j) return 1;
+	unsigned v = s[j] - (t == 4 ? 0xF0u : t == 5 ? 0xF8u : 0xFCu);
+	v = ((v * 64 + (s[j + 1] - 0x80u)) * 64 + (s[j + 2] - 0x80u)) * 64 + (s[j + 3] - 0x80u);
+	if (t >= 5) v = v * 64 + (s[j + 4] - 0x80u);
+	if (t == 6) v = v * 64 + (s[j + 5] - 0x80u);
+	return v > 0xFFFF ? 2 : 1;
+}
+
+/* mb_utflen(s, i): the steps scan s[0..i), so the last can run past i; the
+   units of a step are read from the whole line */
+size_t uni_to16(const unsigned char *s, size_t n, size_t i)
+{
+	size_t u = 0;
+	/*@ loop invariant 0 <= j <= i + 5 && u <= j;
+	    loop invariant to16(s, n, i, 0) == u + to16(s, n, i, j);
+	    loop assigns j, u;
+	    loop variant i - j; */
+	for (size_t j = 0; j < i; j += step(s, i, j)) u += units(s, n, j);
+	return u;
+}
+
+/* mb_utf_index_to_bytes(s, n, u, true), and the line's end where that fails
+   (vim.str_byteindex with strict_indexing false) */
+size_t uni_from16(const unsigned char *s, size_t n, size_t u)
+{
+	if (u == 0) return 0;
+	size_t c = 0;
+	/*@ loop invariant 0 <= j <= n + 5 && c <= j;
+	    loop invariant from16(s, n, u, 0, 0) == from16(s, n, u, j, c);
+	    loop assigns j, c;
+	    loop variant n - j; */
+	for (size_t j = 0; j < n;) {
+		size_t k = step(s, n, j);
+		c += units(s, n, j);
+		if (c >= u) return j + k;
+		j += k;
+	}
+	return n;
+}
