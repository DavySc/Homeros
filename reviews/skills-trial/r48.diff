+#!/usr/bin/env python3
+"""Writes tab.h, uni.c's property tables, from the Unicode 18.0.0 data.
+
+python3 src/uni/gen.py UCD > src/uni/tab.h, where the directory UCD holds,
+from https://github.com/unicode-org/unicodetools at unicodetools/data/ucd/18.0.0/:
+UnicodeData.txt, DerivedCoreProperties.txt, EastAsianWidth.txt,
+auxiliary/GraphemeBreakProperty.txt and emoji/emoji-data.txt.
+
+Byte per code point c: gcb + 16 * incb + 64 * cellc, codes as uni.h's UniData.
+gcb and incb are utf8proc 2.12's boundclass and indic_conjunct_break; cellc
+is Neovim 0.12's utf_ptr2cells(); tests/test_uni_nvim.c checks all three
+against nvim for every c."""
+import sys
+
+N = 0x110000
+GCB = {'CR': 1, 'LF': 1, 'Control': 1, 'Extend': 2, 'L': 3, 'V': 4, 'T': 5, 'LV': 6, 'LVT': 7,
+       'Regional_Indicator': 8, 'SpacingMark': 9, 'Prepend': 10, 'ZWJ': 11}
+INCB = {'Linker': 1, 'Consonant': 2, 'Extend': 3}
+
+
+def ranges(name):
+    """(first, last, fields after the code points) of each data line."""
+    for line in open(f'{sys.argv[1]}/{name}', encoding='utf-8'):
+        line = line.split('#')[0].strip()
+        if line:
+            f = [x.strip() for x in line.split(';')]
+            a, _, b = f[0].partition('..')
+            yield int(a, 16), int(b or a, 16), f[1:]
+
+
+# General_Category; None where UnicodeData.txt lists nothing (a <..., First>
+# and <..., Last> pair is the range between)
+cat = [None] * N
+for a, b, f in ranges('UnicodeData.txt'):
+    if not f[0].endswith('Last>'):
+        cat[a] = f[1]
+    else:
+        cat[first:a + 1] = [f[1]] * (a + 1 - first)
+    first = a
+
+gcb, incb, cellc = [0] * N, [0] * N, [0] * N
+for a, b, (v,) in ranges('auxiliary/GraphemeBreakProperty.txt'):
+    gcb[a:b + 1] = [GCB[v]] * (b + 1 - a)
+for a, b, f in ranges('DerivedCoreProperties.txt'):
+    if f[0] == 'InCB':
+        incb[a:b + 1] = [INCB[f[1]]] * (b + 1 - a)
+amb = [False] * N
+for a, b, (v,) in ranges('EastAsianWidth.txt'):
+    if v in ('W', 'F'):   # Neovim's doublewidth
+        cellc[a:b + 1] = [1] * (b + 1 - a)
+    amb[a:b + 1] = [v == 'A'] * (b + 1 - a)
+for a, b, f in ranges('emoji/emoji-data.txt'):
+    if f[0] == 'Extended_Pictographic':
+        gcb[a:b + 1] = [12] * (b + 1 - a)
+    # Neovim's emoji_wide (gen_unicode_tables.lua): Emoji from U+1F000 on
+    # (older ones are narrow by tradition), not East_Asian_Width A
+    if f[0] == 'Emoji' and a >= 0x1F000:
+        for c in range(a, b + 1):
+            if not amb[c]:
+                cellc[c] = 1
+for c in range(N):
+    # utf8proc has data only for listed code points; Neovim's width tables
+    # leave out unlisted ones and combining marks
+    if cat[c] is None:
+        gcb[c] = incb[c] = cellc[c] = 0
+    elif cat[c] == 'Mn':
+        cellc[c] = 0
+# What uni_width() meets below U+0080 is an overlong form, which Neovim
+# decodes too: utf_ptr2cells() shows NUL as <00> and the other controls as
+# ^X (2 cells, byte2cells()).  <xx>: U+0080..U+009F, not in the default
+# 'isprint'.
+cellc[0] = 2
+cellc[1:0x20] = [1] * 0x1F
+cellc[0x7F] = 1
+cellc[0x80:0xA0] = [2] * 0x20
+# <xxxx>: utf_printable()'s nonprint list
+for a, b in ((0x070F, 0x070F), (0x180B, 0x180E), (0x200B, 0x200F), (0x202A, 0x202E), (0x2060, 0x206F),
+             (0xD800, 0xDFFF), (0xFEFF, 0xFEFF), (0xFFF9, 0xFFFB), (0xFFFE, 0xFFFF)):
+    cellc[a:b + 1] = [3] * (b + 1 - a)
+prop = bytes(g + 16 * i + 64 * w for g, i, w in zip(gcb, incb, cellc))
+
+# Two levels: c / B picks a row of B bytes, equal rows stored once.  B = 128
+# is the smallest total (measured on this data: 32,896 bytes, 189 rows; 64
+# needs 264 rows, past what a byte numbers; 256 takes 37,632).
+B = 128
+rows, t1 = {}, []
+for i in range(0, N, B):
+    t1.append(rows.setdefault(prop[i:i + B], len(rows)))
+print('/* Generated by src/uni/gen.py from the Unicode 18.0.0 data: do not edit. */')
+print(f'#define UNI_B {B}')
+print('static const unsigned char uni_t1[0x110000 / UNI_B] = {')
+for i in range(0, len(t1), 32):
+    print(','.join(map(str, t1[i:i + 32])) + ',')
+print(f'}};\nstatic const unsigned char uni_t2[{len(rows)}][UNI_B] = {{')
+for r in rows:
+    print('{' + ','.join(map(str, r)) + '},')
+print('};')
