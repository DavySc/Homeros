diff --git a/tests/test_uni16_nvim.c b/tests/test_uni16_nvim.c
new file mode 100644
index 0000000..cc82360
--- /dev/null
+++ b/tests/test_uni16_nvim.c
@@ -0,0 +1,99 @@
+/* uni_to16 and uni_from16 against Neovim itself: nvim --headless runs
+   vim.str_utfindex and vim.str_byteindex with 'utf-16' and strict_indexing
+   false, as its LSP client calls them, on random lines of valid and invalid
+   bytes: every byte offset of each line, and every column up to three past
+   its last plus one far past.  The lines mix ASCII and NUL, code points
+   around U+FFFF and U+10FFFF, surrogates, overlong forms, 5- and 6-byte
+   sequences, lead bytes with too few continuation bytes (also at the end of
+   the line) and stray continuation bytes.  SEED in the environment draws
+   other lines. */
+#include <string.h>
+#include "check.h"
+#include "uni.h"
+
+#define LINES 20000
+#define FAR ((size_t)1 << 40)
+
+static const char lua[] =
+	"local f = io.open(arg[1] .. '.out', 'w')\n"
+	"for h in io.lines(arg[1] .. '.lines') do\n"
+	"  local s, t = h:gsub('..', function(x) return string.char(tonumber(x, 16)) end), {}\n"
+	"  for i = 0, #s do t[#t + 1] = vim.str_utfindex(s, 'utf-16', i, false) end\n"
+	"  for u = 0, vim.str_utfindex(s, 'utf-16') + 3 do t[#t + 1] = vim.str_byteindex(s, 'utf-16', u, false) end\n"
+	"  t[#t + 1] = vim.str_byteindex(s, 'utf-16', 2 ^ 40, false)\n"
+	"  f:write(table.concat(t, ' '), '\\n')\n"
+	"end\n"
+	"f:close()\n";
+
+/* a lead byte for k bytes and a value's 6-bit groups after it, unchecked:
+   so overlong forms, surrogates and values past U+10FFFF come out too */
+static size_t enc(unsigned long c, size_t k, unsigned char *s)
+{
+	static const unsigned char lead[7] = { 0, 0, 0xC0, 0xE0, 0xF0, 0xF8, 0xFC };
+	for (size_t q = k; --q > 0; c /= 64) s[q] = (unsigned char)(0x80 + c % 64);
+	s[0] = (unsigned char)(lead[k] + c % (0x80u >> k));
+	return k;
+}
+
+static size_t line(unsigned char *s)
+{
+	static const unsigned long near[] = { 0x7F, 0x80, 0x7FF, 0x800, 0xD7FF, 0xD800, 0xDBFF, 0xDC00, 0xDFFF, 0xE000,
+		0xFFFD, 0xFFFF, 0x10000, 0x1F600, 0x10FFFF, 0x110000, 0x1FFFFF, 0x200000, 0x3FFFFFF, 0x4000000, 0x7FFFFFFF };
+	static const unsigned char tail[] = { 0x80, 0x8F, 0x90, 0xBF };
+	size_t n = 0;
+	for (unsigned k = 1 + rnd(10); k--;) {
+		unsigned x = rnd(100), w = 2 + rnd(5);
+		if (x < 20) s[n++] = (unsigned char)"a z\t~\0"[rnd(6)];
+		else if (x < 35) n += enc(near[rnd(sizeof near / sizeof *near)] - rnd(2), w, s + n);
+		else if (x < 55) n += enc(0x10000 + rnd(0x100000), 4, s + n);
+		else if (x < 70) n += enc(rnd(0x10000), 2 + rnd(2), s + n);
+		else if (x < 80) n += enc(rnd(0x7FFFFFFF), w, s + n);
+		else if (x < 90) n += enc(rnd(0x7FFFFFFF), w, s + n) - 1 - rnd(w - 1);   /* cut off */
+		else if (x < 96) s[n++] = (unsigned char)(0x80 + rnd(0x80));
+		else for (unsigned m = 1 + rnd(6); m--;) s[n++] = rnd(2) ? tail[rnd(4)] : (unsigned char)(0x80 + rnd(0x40));
+	}
+	return n;
+}
+
+int main(void)
+{
+	const char *seed = getenv("SEED");
+	if (seed) rng = strtoull(seed, 0, 10) * 2 + 1;   /* xorshift needs a nonzero state */
+	static unsigned char lines[LINES][64];
+	static size_t len[LINES];
+	FILE *f = fopen("build/uni16_nvim.lines", "w");
+	CHECK(f);
+	for (int r = 0; r < LINES; r++) {
+		len[r] = line(lines[r]);
+		for (size_t i = 0; i < len[r]; i++) fprintf(f, "%02x", lines[r][i]);
+		fputc('\n', f);
+	}
+	fclose(f);
+	f = fopen("build/uni16_nvim.lua", "w");
+	CHECK(f && fputs(lua, f) >= 0);
+	fclose(f);
+	CHECK(system("nvim --clean --headless -l build/uni16_nvim.lua build/uni16_nvim") == 0);
+
+	f = fopen("build/uni16_nvim.out", "r");
+	CHECK(f);
+	unsigned long calls = 0, want;
+	for (int r = 0; r < LINES; r++) {
+		const unsigned char *s = lines[r];
+		size_t n = len[r], u = uni_to16(s, n, n);
+		for (size_t i = 0; i <= n; i++, calls++) {
+			CHECK(fscanf(f, "%lu", &want) == 1);
+			if (want != uni_to16(s, n, i)) fprintf(stderr, "line %d: to16 at %zu: %zu, nvim %lu\n", r + 1, i, uni_to16(s, n, i), want);
+			CHECK(want == uni_to16(s, n, i));
+		}
+		for (size_t c = 0; c <= u + 4; c++, calls++) {
+			size_t k = c <= u + 3 ? c : FAR;
+			CHECK(fscanf(f, "%lu", &want) == 1);
+			if (want != uni_from16(s, n, k)) fprintf(stderr, "line %d: from16 at %zu: %zu, nvim %lu\n", r + 1, k, uni_from16(s, n, k), want);
+			CHECK(want == uni_from16(s, n, k));
+		}
+	}
+	CHECK(fscanf(f, "%lu", &want) == EOF);
+	fclose(f);
+	printf("test_uni16_nvim: %d lines, %lu calls against Neovim's str_utfindex and str_byteindex\n", LINES, calls);
+	return 0;
+}
