+		if (!s || !s->q.n || s->cancel) return s && key == KEY_BREAK;
 		if (db_state(&s->db) != DB_BUSY || db_cancel(&s->db)) drop(s);   /* logging in: the connection goes */
 		else {   /* the run stays busy until the server answers (SqlSess.tla's Break and Ack) */
 			s->cancel = 1;
