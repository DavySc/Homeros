index ec47885..69e81a2 100644
--- a/src/uni/uni.c
+++ b/src/uni/uni.c
@@ -86,12 +86,16 @@ size_t uni_glen(const unsigned char *s, size_t n, size_t i)
 		unsigned c = dec(s, n, j, k);
 		q = prop(c);
 		unsigned t = q % 16, it = q / 16 % 4;
+		//@ assert t == gcb(c) && it == incb(c);
 		int glue = l != 1 && t != 1 &&
 			((l == 3 && (t == 3 || t == 4 || t == 6 || t == 7)) ||
 			 ((l == 6 || l == 4) && (t == 4 || t == 5)) ||
 			 ((l == 7 || l == 5) && t == 5) ||
 			 t == 2 || t == 11 || t == 9 || l == 10 ||
 			 (l == 13 && t == 12) || (l == 8 && t == 8));
+		/* a step for the provers: without it CVC5 timed out on the invariant at 20 s
+		   under load (measured: 4 of 4 runs; 16.8 s with a 90 s limit) */
+		//@ assert glue != 0 <==> glue(l, t);
 		if (!glue && !(ic == 1 && it == 2) &&
 		    !(p == 0x644 && (c == 0x622 || c == 0x623 || c == 0x625 || c == 0x627)))
 			break;
@@ -121,3 +125,16 @@ size_t uni_gprev(const unsigned char *s, size_t n, size_t i)
 		j += k;
 	}
 }
+
+/* Neovim's utf_ptr2cells(): the cells code of the code point, except that a
+   one-cell emoji or regional indicator followed by U+FE0F takes two. */
+int uni_width(const unsigned char *s, size_t n, size_t i)
+{
+	if (s[i] < 0x80) return 1;
+	size_t k = uni_len(s, n, i);
+	if (k == 1) return 4;
+	unsigned q = prop(dec(s, n, i, k)), w = q / 64, t = q % 16;
+	if (w == 0 && (t == 12 || t == 8) && i + k < n && dec(s, n, i + k, uni_len(s, n, i + k)) == 0xFE0F)
+		return 2;
+	return w == 0 ? 1 : (int)(2 * w);
+}
