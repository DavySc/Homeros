(dolist (d '("compat" "cond-let" "llama" "transient/lisp" "with-editor/lisp" "magit/lisp")) (add-to-list 'load-path (expand-file-name d "/home/claude/magit")))
(setq gc-cons-threshold (* 100 1024 1024))
(require 'magit)
(defvar n-calls 0) (defvar calls nil)
(defun count-git (orig program &rest args) (when (string-match-p "git" (format "%s" program)) (setq n-calls (1+ n-calls)) (push (mapconcat (lambda (a) (format "%s" a)) (flatten-tree args) " ") calls)) (apply orig program args))
(advice-add 'process-file :around #'count-git)
(advice-add 'call-process :around #'count-git)
(advice-add 'make-process :around (lambda (orig &rest a) (setq n-calls (1+ n-calls)) (push (format "make-process %S" (plist-get a :command)) calls) (apply orig a)))
(let ((default-directory "/home/claude/magit/repo/"))
  (dotimes (i 4)
    (setq n-calls 0 calls nil)
    (let ((t0 (float-time)))
      (if (= i 0) (magit-status-setup-buffer default-directory)
        (with-current-buffer (magit-get-mode-buffer 'magit-status-mode) (magit-refresh-buffer)))
      (princ (format "run %d: %.3f s, %d git processes\n" i (- (float-time) t0) n-calls))))
  (with-temp-file "/home/claude/magit/calls.txt" (insert (mapconcat #'identity (reverse calls) "\n")))
  (with-current-buffer (magit-get-mode-buffer 'magit-status-mode) (princ (buffer-substring-no-properties (point-min) (min (point-max) 1500)))))
