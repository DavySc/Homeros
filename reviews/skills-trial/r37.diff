+
+/* UTF-16 columns copy Neovim's mb_utflen() and mb_utf_index_to_bytes(),
+   which the LSP client reaches through vim.str_utfindex and
+   vim.str_byteindex. */
+
+/* utf_ptr2len_len(s + j, lim - j) over utf8len_tab (5- and 6-byte forms
+   included): a form cut by lim counts whole. */
+/*@ requires j < lim && \valid_read(s + (0 .. lim - 1));
+    assigns \nothing;
+    ensures \result == nstep(s, j, lim);
+    ensures 1 <= \result <= 6;
+*/
+static size_t seq(const unsigned char *s, size_t j, size_t lim)
+{
+	unsigned char c = s[j];
+	size_t k = c < 0xC0 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : c < 0xF8 ? 4 : c < 0xFC ? 5 : c < 0xFE ? 6 : 1;
+	//@ assert k == nlen(c);
+	/*@ loop invariant 1 <= m <= k;
+	    loop invariant \forall integer t; 1 <= t < m ==> cont(s[j + t]);
+	    loop assigns m;
+	    loop variant k - m; */
+	for (size_t m = 1; m < k && m < lim - j; m++)
+		if (s[j + m] < 0x80 || s[j + m] >= 0xC0) return 1;
+	return k;
+}
+
+/* utf_ptr2char() reads the form at j as above U+FFFF, so it takes two
+   UTF-16 units.  Only the first k - 2 bytes can decide that, as the last
+   two add at most 0xFFF; an invalid or cut form reads as its first byte. */
+/*@ requires j < n && \valid_read(s + (0 .. n - 1));
+    assigns \nothing;
+    ensures \result == units(s, n, j);
+*/
+static size_t pair(const unsigned char *s, size_t n, size_t j)
+{
+	size_t k = seq(s, j, n);
+	if (k < 4 || k > n - j) return 1;
+	if (k == 4) return s[j] > 0xF0 || s[j + 1] >= 0x90 ? 2 : 1;
+	if (k == 5) return s[j] > 0xF8 || s[j + 1] > 0x80 || s[j + 2] >= 0x90 ? 2 : 1;
+	return s[j] > 0xFC || s[j + 1] > 0x80 || s[j + 2] > 0x80 || s[j + 3] >= 0x90 ? 2 : 1;
+}
+
+size_t uni_u16(const unsigned char *s, size_t n, size_t i)
+{
+	size_t u = 0, j = 0;
+	if (i > n) i = n;
+	/*@ loop invariant 0 <= j <= i + 5 && u <= 2 * j;
+	    loop invariant u16(s, n, 0, i) == u + u16(s, n, j, i);
+	    loop assigns j, u;
+	    loop variant i - j; */
+	while (j < i) {
+		u += pair(s, n, j);
+		j += seq(s, j, i);
+	}
+	return u;
+}
+
+size_t uni_u16byte(const unsigned char *s, size_t n, size_t c)
+{
+	size_t u = 0, j = 0;
+	if (c == 0) return 0;
+	/*@ loop invariant 0 <= j <= n + 5 && u <= 2 * j;
+	    loop invariant b16(s, n, 0, 0, c) == b16(s, n, j, u, c);
+	    loop assigns j, u;
+	    loop variant n - j; */
+	while (j < n) {
+		size_t k = seq(s, j, n);
+		u += pair(s, n, j);
+		if (u >= c) return j + k;
+		j += k;
+	}
+	return n;
+}
