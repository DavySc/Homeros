;;; -*- lexical-binding: t -*-
(setq native-comp-jit-compilation nil)
(dolist (d '("compat" "cond-let" "llama" "transient/lisp" "with-editor/lisp" "magit/lisp" "evil" "evil-collection" "annalist.el" "goto-chg"))
  (add-to-list 'load-path (expand-file-name d "/home/claude/magit")))
(setq evil-want-keybinding nil evil-want-integration t)
(require 'evil)
(evil-mode 1)
(require 'magit)
(require 'evil-collection)
(evil-collection-init '(magit with-editor))
(setq inhibit-startup-screen t make-backup-files nil auto-save-default nil create-lockfiles nil)
(server-start)
(menu-bar-mode -1)
(defun rec-state ()
  "busy or idle, then each window: top|bottom|buffer|selected."
  (concat
   (if (and (seq-some (lambda (p) (and (process-live-p p) (string-match-p "git" (format "%s" (process-command p)))))
                      (process-list))
            (not (seq-some (lambda (b) (buffer-local-value 'with-editor-mode b)) (buffer-list))))
       "busy" "idle")
   (mapconcat (lambda (w) (let ((e (window-inside-edges w)))
                            (format ";%d|%d|%s|%s" (nth 1 e) (nth 3 e) (buffer-name (window-buffer w))
                                    (if (eq w (selected-window)) "*" ""))))
              (window-list nil 'never) "")))
