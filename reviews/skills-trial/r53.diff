--- a/include/uni.h
+++ b/include/uni.h
@@ -145,4 +145,60 @@ size_t uni_gprev(const unsigned char *s, size_t n, size_t i);
        i + ulen(s, n, i) < n && cpx(s, n, i + ulen(s, n, i)) == 0xFE0F ? 2 : cells(cellc(cpx(s, n, i))));
