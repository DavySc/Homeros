+#!/usr/bin/env python3
+"""Generate tab.h, the property byte of every code point, for uni.c.
+
+    python3 src/uni/gen.py UCD_DIR > src/uni/tab.h
+
+UCD_DIR holds these Unicode 18.0.0 files (the version of the utf8proc that
+the tools' Neovim links), downloaded unchanged from
+https://raw.githubusercontent.com/unicode-org/unicodetools/main/unicodetools/data/ucd/18.0.0/
+(unicode.org/Public/18.0.0/ucd/ has the same files):
+    UnicodeData.txt, auxiliary/GraphemeBreakProperty.txt,
+    emoji/emoji-data.txt, DerivedCoreProperties.txt, EastAsianWidth.txt
+(auxiliary/GraphemeBreakTest.txt from there is src/uni/GraphemeBreakTest.txt).
+
+The byte is gcb + 16 * incb + 64 * cellc with include/uni.h's codes.  Where
+the rules below are Neovim's or utf8proc's rather than Unicode's, the comment
+says so; tests/test_uni_nvim.c checks every code point against nvim.
+"""
+import os
+import sys
+
+TOP = 0x110000
+GCB = {'CR': 1, 'LF': 1, 'Control': 1, 'Extend': 2, 'L': 3, 'V': 4, 'T': 5, 'LV': 6,
+       'LVT': 7, 'Regional_Indicator': 8, 'SpacingMark': 9, 'Prepend': 10, 'ZWJ': 11}
+INCB = {'Linker': 1, 'Consonant': 2, 'Extend': 3}
+# Neovim's utf_printable() nonprint table: shown as <xxxx>
+NONPRINT = [(0x70F, 0x70F), (0x180B, 0x180E), (0x200B, 0x200F), (0x202A, 0x202E),
+            (0x2060, 0x206F), (0xD800, 0xDFFF), (0xFEFF, 0xFEFF), (0xFFF9, 0xFFFB),
+            (0xFFFE, 0xFFFF)]
+
+
+def ranges(path, prop=None):
+    """(first, last, value) of each data line; with prop, its lines only."""
+    for line in open(path, encoding='utf-8'):
+        f = [x.strip() for x in line.split('#')[0].split(';')]
+        if len(f) < 2 or (prop and f[1] != prop):
+            continue
+        a, _, b = f[0].partition('..')
+        yield int(a, 16), int(b or a, 16), f[-1]
+
+
+def main(d):
+    # utf8proc stores properties for assigned code points only: an unassigned
+    # one is Other, not Extended_Pictographic nor Control, and Neovim takes it
+    # as one cell even in a wide block
+    gc = {}
+    first = None
+    for line in open(os.path.join(d, 'UnicodeData.txt'), encoding='utf-8'):
+        f = line.split(';')
+        c = int(f[0], 16)
+        if f[1].endswith('First>'):
+            first = c
+            continue
+        for x in range(c if first is None else first, c + 1):
+            gc[x] = f[2]
+        first = None
+
+    gcb = [0] * TOP
+    for a, b, v in ranges(os.path.join(d, 'auxiliary', 'GraphemeBreakProperty.txt')):
+        for c in range(a, b + 1):
+            gcb[c] = GCB[v] if c in gc else 0
+    emoji = set()
+    for a, b, v in ranges(os.path.join(d, 'emoji', 'emoji-data.txt')):
+        for c in range(a, b + 1):
+            if v == 'Extended_Pictographic' and c in gc:
+                gcb[c] = 12
+            if v == 'Emoji':
+                emoji.add(c)
+    incb = [0] * TOP
+    for a, b, v in ranges(os.path.join(d, 'DerivedCoreProperties.txt'), 'InCB'):
+        for c in range(a, b + 1):
+            incb[c] = INCB[v]
+    eaw = {}
+    for a, b, v in ranges(os.path.join(d, 'EastAsianWidth.txt')):
+        for c in range(a, b + 1):
+            eaw[c] = v
+
+    def cellc(c):
+        # ASCII reaches the table only in an overlong form, which Neovim's
+        # utf_ptr2cells() reads as the character: NUL as <00>, controls as ^X
+        if c < 0x80:
+            return 2 if c == 0 else 1 if c < 0x20 or c == 0x7F else 0
+        if c < 0xA0:          # not in the default 'isprint': <xx>
+            return 2
+        if any(a <= c <= b for a, b in NONPRINT):
+            return 3
+        if c not in gc or gc[c] == 'Mn':
+            return 0
+        # Neovim's doublewidth (East Asian Width W and F) and emoji_wide
+        # (Emoji from U+1F000 on, but not those of ambiguous width)
+        w = eaw.get(c, 'N')
+        return 1 if w in ('W', 'F') or (c in emoji and c >= 0x1F000 and w != 'A') else 0
+
+    prop = [gcb[c] + 16 * incb[c] + 64 * cellc(c) for c in range(TOP)]
+
+    # Two levels: uni_t1 (bytes) picks one of the distinct rows of UNI_B
+    # values, which must number at most 256; UNI_B is the power of two with
+    # the fewest bytes in all.  uni_t2 has exactly the rows used: WP reads the
+    # const initializers and proves uni.c's reads in bounds.
+    best = None
+    for k in range(4, 12):
+        n = 1 << k
+        rows = {}
+        t1 = [rows.setdefault(tuple(prop[i:i + n]), len(rows)) for i in range(0, TOP, n)]
+        size = len(t1) + len(rows) * n
+        if len(rows) <= 256 and (best is None or size < best[0]):
+            best = size, n, t1, list(rows)
+    size, n, t1, rows = best
+
+    o = sys.stdout
+    o.write('/* Generated by src/uni/gen.py from Unicode 18.0.0 data; do not edit.\n'
+            '   uni_t2[uni_t1[c / UNI_B]][c %% UNI_B] is gcb + 16 * incb + 64 * cellc\n'
+            '   (include/uni.h) for c below 0x110000; %d bytes. */\n' % size)
+    o.write('#define UNI_B %d\n' % n)
+    o.write('static const unsigned char uni_t1[0x110000 / UNI_B] = {\n')
+    for i in range(0, len(t1), 24):
+        o.write(','.join(str(x) for x in t1[i:i + 24]) + ',\n')
+    o.write('};\nstatic const unsigned char uni_t2[%d][UNI_B] = {\n' % len(rows))
+    for r in rows:
+        o.write('{' + ','.join(str(x) for x in r) + '},\n')
+    o.write('};\n')
+
+
+if __name__ == '__main__':
+    main(sys.argv[1])
