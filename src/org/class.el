;;; -*- lexical-binding: t -*-
;; Writes class.h: the code point ranges that Emacs 31.1's regexps in an
;; org-mode buffer take for [[:word:]], [[:alnum:]] and whitespace (\s-,
;; [[:space:]]), so the parser's character classes are Emacs's own.
;; emacs -Q --batch -l src/org/class.el > src/org/class.h
(require 'org)
(with-temp-buffer
  (org-mode)
  (princ "/* Generated by src/org/class.el from Emacs 31.1 (org-mode syntax table); do not edit. */\n")
  (dolist (spec '(("WORD" . "[[:word:]]") ("ALNUM" . "[[:alnum:]]") ("SPACE" . "\\s-")))
    (let ((re (concat "\\`" (cdr spec) "\\'")) (c 0) start (case-fold-search nil))
      (princ (format "static const unsigned %s[][2] = {" (car spec)))
      (while (<= c #x110000)
        (let ((m (and (<= c #x10ffff) (not (<= #xd800 c #xdfff)) (string-match-p re (string c)))))
          (cond ((and m (not start)) (setq start c))
                ((and (not m) start (not (<= #xd800 c #xdfff)))
                 (princ (format "{0x%x,0x%x}," start (1- c))) (setq start nil))))
        (setq c (1+ c)))
      (princ "};\n"))))
