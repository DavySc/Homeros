+/* Neovim's utf8len_tab, utf_ptr2len_len() and utf_ptr2char() (src/nvim/mbyte.c) */
+static int nlen(uint8_t c) { return c < 0xC0 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : c < 0xF8 ? 4 : c < 0xFC ? 5 : c < 0xFE ? 6 : 1; }
+static int len_len(const uint8_t *p, int size)
+{
+	int len = nlen(*p), m = len > size ? size : len;
+	for (int i = 1; i < m; i++) if ((p[i] & 0xc0) != 0x80) return 1;
+	return len;
+}
+static long ptr2char(const uint8_t *p)
+{
+	int len = nlen(*p);
+	long c = len == 1 ? *p : *p & (0x7f >> len);
+	for (int i = 1; i < len; i++) { if ((p[i] & 0xc0) != 0x80) return *p; c = c << 6 | (p[i] & 0x3f); }
+	return c;
+}
+/* mb_utflen() over p[0..len): UTF-16 units */
+static size_t utflen(const uint8_t *p, size_t len)
+{
+	size_t u = 0, clen;
+	for (size_t i = 0; i < len; i += clen) {
+		clen = (size_t)len_len(p + i, (int)(len - i));
+		u += clen > 1 && ptr2char(p + i) > 0xFFFF ? 2 : 1;
+	}
+	return u;
+}
+/* mb_utf_index_to_bytes(), with str_byteindex's answer for -1 */
+static size_t index2bytes(const uint8_t *p, size_t len, size_t index)
+{
+	size_t count = 0, clen;
+	if (index == 0) return 0;
+	for (size_t i = 0; i < len; i += clen) {
+		clen = (size_t)len_len(p + i, (int)(len - i));
+		count += clen > 1 && ptr2char(p + i) > 0xFFFF ? 2 : 1;
+		if (count >= index) return i + clen;
+	}
+	return len;
+}
