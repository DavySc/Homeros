 int uni_width(const unsigned char *s, size_t n, size_t i);
+
+/* UTF-16 columns, for LSP positions (DESIGN.md: byte offsets inside, UTF-16
+   at the LSP boundary, per line).  Both copy Neovim 0.12's LSP client:
+   vim.str_utfindex(s, 'utf-16', i, false), which is mb_utflen() over
+   s[0..i), and vim.str_byteindex(s, 'utf-16', u, false), which is
+   mb_utf_index_to_bytes().  Neovim steps by utf_ptr2len_len(), whose table
+   still reads 5- and 6-byte sequences and which takes a sequence cut off at
+   the end of what it scans whole if the bytes it sees are continuation
+   bytes; a step counts 2 units when utf_ptr2char() decodes a whole sequence
+   above U+FFFF, else 1 (an invalid byte counts 1). */
+/*@ logic integer vlen(integer c) = c < 0xC0 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : c < 0xF8 ? 4 :
+                                    c < 0xFC ? 5 : c < 0xFE ? 6 : 1;
+    // s[j + 1 .. j + k) are continuation bytes, listed so the provers finish
+    predicate vrun{L}(unsigned char *s, integer j, integer k) =
+      (k >= 2 ==> cont(s[j + 1])) && (k >= 3 ==> cont(s[j + 2])) && (k >= 4 ==> cont(s[j + 3])) &&
+      (k >= 5 ==> cont(s[j + 4])) && (k >= 6 ==> cont(s[j + 5]));
+    // utf_ptr2len_len(s + j, m - j)
+    logic integer vstep{L}(unsigned char *s, integer m, integer j) =
+      vrun(s, j, \min(vlen(s[j]), m - j)) ? vlen(s[j]) : 1;
+    // what utf_ptr2char() decodes from a whole sequence of k >= 4 bytes
+    logic integer vval{L}(unsigned char *s, integer j, integer k) =
+      k == 4 ? (((s[j] - 0xF0) * 64 + pay(s[j + 1])) * 64 + pay(s[j + 2])) * 64 + pay(s[j + 3]) :
+      k == 5 ? ((((s[j] - 0xF8) * 64 + pay(s[j + 1])) * 64 + pay(s[j + 2])) * 64 + pay(s[j + 3])) * 64 +
+               pay(s[j + 4]) :
+      (((((s[j] - 0xFC) * 64 + pay(s[j + 1])) * 64 + pay(s[j + 2])) * 64 + pay(s[j + 3])) * 64 +
+       pay(s[j + 4])) * 64 + pay(s[j + 5]);
+    logic integer vunits{L}(unsigned char *s, integer n, integer j) =
+      vlen(s[j]) >= 4 && j + vlen(s[j]) <= n && vrun(s, j, vlen(s[j])) &&
+      vval(s, j, vlen(s[j])) > 0xFFFF ? 2 : 1;
+    // units in the steps from j that start before m (mb_utflen(s, m))
+    logic integer to16{L}(unsigned char *s, integer n, integer m, integer j) =
+      j >= m ? 0 : vunits(s, n, j) + to16(s, n, m, j + vstep(s, m, j));
+    // the end of the first step from j at which the c units before j and the
+    // step's own reach u (mb_utf_index_to_bytes()), or n if none does
+    logic integer from16{L}(unsigned char *s, integer n, integer u, integer j, integer c) =
+      j >= n ? n : c + vunits(s, n, j) >= u ? j + vstep(s, n, j) :
+      from16(s, n, u, j + vstep(s, n, j), c + vunits(s, n, j));
+*/
+
+/* UTF-16 units in s[0..i).  An i inside a sequence counts the whole
+   sequence.  (The bound on n: LSP positions are below 2^31.) */
+/*@ requires n < 0x80000000 && i <= n && \valid_read(s + (0 .. n - 1));
+    assigns \nothing;
+    ensures \result == to16(s, n, i, 0);
+*/
+size_t uni_to16(const unsigned char *s, size_t n, size_t i);
+
+/* Byte offset of UTF-16 column u: 0 for 0, else the end of the step that
+   holds unit u (so a column inside a surrogate pair rounds up), and n for
+   a column past the end.  As in Neovim, a line that ends in a cut-off
+   sequence can give an offset past n, by up to 5. */
+/*@ requires n < 0x80000000 && \valid_read(s + (0 .. n - 1));
+    assigns \nothing;
+    ensures \result == (u == 0 ? 0 : from16(s, n, u, 0, 0));
+*/
+size_t uni_from16(const unsigned char *s, size_t n, size_t u);
 #endif
