diff --git a/src/uni/uni.c b/src/uni/uni.c
index ec47885..2ececa3 100644
--- a/src/uni/uni.c
+++ b/src/uni/uni.c
@@ -121,3 +121,16 @@ size_t uni_gprev(const unsigned char *s, size_t n, size_t i)
 		j += k;
 	}
 }
+
+/* Neovim's utf_ptr2cells(): an invalid byte is <xx>; a one-cell emoji or
+   regional indicator followed by U+FE0F takes two cells (read as
+   utf_ptr2char() reads, so an overlong U+FE0F counts too). */
+int uni_width(const unsigned char *s, size_t n, size_t i)
+{
+	if (s[i] < 0x80) return 1;
+	size_t k = uni_len(s, n, i);
+	if (k == 1) return 4;
+	unsigned q = prop(dec(s, n, i, k)), w = q / 64, b = q % 16;
+	if (w == 0 && (b == 12 || b == 8) && i + k < n && dec(s, n, i + k, uni_len(s, n, i + k)) == 0xFE0F) return 2;
+	return w == 0 ? 1 : w == 1 ? 2 : w == 2 ? 4 : 6;
+}
