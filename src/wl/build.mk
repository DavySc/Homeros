# src/wl (package 8): the window backend.  The protocol glue is generated by
# wayland-scanner into build/wl/ and compiled outside our warnings.
WL_PKGS = wayland-client xkbcommon
WL_DIR := $(shell pkg-config --variable=pkgdatadir wayland-protocols)
WL_XML = $(WL_DIR)/stable/xdg-shell/xdg-shell.xml $(WL_DIR)/unstable/text-input/text-input-unstable-v1.xml \
  $(WL_DIR)/staging/cursor-shape/cursor-shape-v1.xml $(WL_DIR)/stable/tablet/tablet-v2.xml
CPPFLAGS += -DHOMEROS_WL -Ibuild/wl $(shell pkg-config --cflags $(WL_PKGS))
LIBS += $(shell pkg-config --libs $(WL_PKGS))
OBJS += $(patsubst %.xml,build/wl/%.o,$(notdir $(WL_XML)))

# The weston tests: weston 16 with its test plugin, which types, clicks and
# scrolls through a seat of its own (weston-test.nix), run as a separate
# process; the test is also the input method weston starts.  Both renderers:
# pixman holds a buffer until the next is shown, GL (Mesa's llvmpipe) gives
# it back at commit, as Hyprland does, and only that catches a backend that
# draws without waiting for the frame callback.
WL_TEST_XML = build/wl/weston/share/weston-test.xml build/wl/weston/share/weston-output-capture.xml $(WL_DIR)/unstable/input-method/input-method-unstable-v1.xml
WL_TEST_OBJS = $(patsubst %.xml,build/wl/%.o,$(notdir $(WL_TEST_XML)))

build/wl/%.o: | build/wl
	wayland-scanner client-header $(filter %/$*.xml,$(WL_XML) $(WL_TEST_XML)) build/wl/$*.h
	wayland-scanner private-code $(filter %/$*.xml,$(WL_XML) $(WL_TEST_XML)) build/wl/$*.c
	$(CC) -O2 -c -o $@ build/wl/$*.c
build/wl/weston-test.o build/wl/weston-output-capture.o: build/wl/weston

build/wl/weston: src/wl/weston-test.nix | build/wl
	nix-build src/wl/weston-test.nix -o $@

wl-test: homeros $(OBJS) $(WL_TEST_OBJS) | build/san
	@gcc $(WARN) $(CPPFLAGS) $(SAN) -o build/san/wl_weston tests/wl_weston.c \
	  $(filter-out src/main.c,$(SRCS)) $(OBJS) $(WL_TEST_OBJS) $(LIBS)
	@for r in pixman gl; do echo "weston, $$r renderer"; \
	  WL_RENDERER=$$r WESTON=build/wl/weston HOMEROS=$$PWD/homeros ./build/san/wl_weston || { echo "FAIL wl_weston ($$r)"; exit 1; }; done
test: wl-test
.PHONY: wl-test
