diff --git a/src/uni/uni.c b/src/uni/uni.c
index 7c087c5..ca6a96e 100644
--- a/src/uni/uni.c
+++ b/src/uni/uni.c
@@ -103,6 +103,25 @@ size_t uni_glen(const unsigned char *s, size_t n, size_t i)
 	return j - i;
 }
 
+/* Helix's rule (uni.h): step forward from a known start, so the step back
+   lands on the starts uni_glen makes even where a backward reading of the
+   rules would not (regional indicator pairs, GB9c conjuncts, lam-alef).
+   Nothing joins an ASCII byte to what precedes it, so the walk starts at the
+   last one before i (or at 0) and costs the length of the non-ASCII run. */
+size_t uni_gprev(const unsigned char *s, size_t n, size_t i)
+{
+	size_t b = i - 1, g;
+	/*@ loop invariant 0 <= b <= i - 1;
+	    loop assigns b;
+	    loop variant b; */
+	while (b > 0 && s[b] >= 0x80) b--;
+	/*@ loop invariant bound(s, n, b) && b < i;
+	    loop assigns b, g;
+	    loop variant i - b; */
+	while ((g = uni_glen(s, n, b)) < i - b) b += g;
+	return b;
+}
+
 int uni_width(const unsigned char *s, size_t n, size_t i)
 {
 	if (s[i] < 0x80) return 1;
