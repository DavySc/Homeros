;; Summarise an org file with Org's own parser (org-element): the reference.
(require 'org-element) (require 'json)
(setq org-todo-keywords '((sequence "TODO(t)" "NEXT(n)" "WAIT(w@)" "|" "DONE(d!)" "CANCELLED(c@)")))
(defun s (file)
  (with-temp-buffer
    (insert-file-contents file) (setq default-directory (file-name-directory (expand-file-name file))) (let ((org-inhibit-startup t)) (delay-mode-hooks (org-mode)))
    (let* ((tree (org-element-parse-buffer))
           (count (lambda (type &optional pred) (length (org-element-map tree type (lambda (e) (when (or (not pred) (funcall pred e)) e)) nil nil nil t)))))
      `((headlines . ,(funcall count 'headline))
        (h1 . ,(funcall count 'headline (lambda (e) (= 1 (org-element-property :level e)))))
        (h3plus . ,(funcall count 'headline (lambda (e) (>= (org-element-property :level e) 3))))
        (todo . ,(funcall count 'headline (lambda (e) (org-element-property :todo-keyword e))))
        (tagged . ,(funcall count 'headline (lambda (e) (org-element-property :tags e))))
        (src_blocks . ,(funcall count 'src-block))
        (example_blocks . ,(funcall count 'example-block))
        (tables . ,(funcall count 'table))
        (timestamps . ,(funcall count 'timestamp))
        (links . ,(funcall count 'link))
        (property_drawers . ,(funcall count 'property-drawer))
        (plain_lists . ,(funcall count 'plain-list))
        (footnote_refs . ,(funcall count 'footnote-reference))))))
(princ (json-encode (mapcar (lambda (f) (cons (file-name-nondirectory f) (condition-case e (s f) (error (list (cons 'error (format "%S" e))))))) command-line-args-left)))
(setq command-line-args-left nil)
