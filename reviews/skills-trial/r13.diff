@@ -95,6 +95,8 @@ size_t uni_glen(const unsigned char *s, size_t n, size_t i)
 		if (!glue && !(ic == 1 && it == 2) &&
 		    !(p == 0x644 && (c == 0x622 || c == 0x623 || c == 0x625 || c == 0x627)))
 			break;
+		/* one unfolding of more, so the invariant's step is a rewrite */
+		//@ assert more(s, n, j, l, ic, p) == k + more(s, n, j + k, nbc(l, t), nic(ic, it), c);
 		l = l == 8 && t == 8 ? 0 : l == 12 && t == 2 ? 12 : l == 12 && t == 11 ? 13 : t;
 		ic = ic == 1 && it == 3 ? 1 : it;
 		p = c;
@@ -103,6 +105,28 @@ size_t uni_glen(const unsigned char *s, size_t n, size_t i)
 	return j - i;
 }
 
+/* Clusters are what uni_glen's steps make, so a step back replays them
+   (Helix's rule, uni.h) from the last start known without them: an ASCII
+   byte, which no cluster holds after its first, or 0.  Cost: the bytes back
+   to that start, which in a line without ASCII is the whole line before i. */
+size_t uni_gprev(const unsigned char *s, size_t n, size_t i)
+{
+	size_t j = i - 1;
+	/*@ loop invariant 0 <= j <= i - 1;
+	    loop assigns j;
+	    loop variant j; */
+	while (j > 0 && s[j] >= 0x80) j--;
+	//@ assert bound(s, n, j);
+	/*@ loop invariant 0 <= j < i && bound(s, n, j);
+	    loop assigns j;
+	    loop variant i - j; */
+	for (;;) {
+		size_t g = uni_glen(s, n, j);
+		if (g >= i - j) return j;
+		j += g;
+	}
+}
+
 int uni_width(const unsigned char *s, size_t n, size_t i)
 {
 	if (s[i] < 0x80) return 1;
