+/* Neovim 0.12's utf8len_tab, utf_ptr2len_len(), utf_ptr2char() (which
+   reads up to the string's NUL) and the loops of mb_utflen() and
+   mb_utf_index_to_bytes(), as written there */
+static int tab(unsigned c) { return c < 0xC0 ? 1 : c < 0xE0 ? 2 : c < 0xF0 ? 3 : c < 0xF8 ? 4 : c < 0xFC ? 5 : c < 0xFE ? 6 : 1; }
+static int ptr2len_len(const uint8_t *p, int size)
+{
+	int len = tab(p[0]), m = len > size ? size : len;
+	if (len == 1) return 1;
+	for (int i = 1; i < m; i++) if ((p[i] & 0xc0) != 0x80) return 1;
+	return len;
+}
+static long ptr2char(const uint8_t *p)
+{
+	int len = p[0] < 0xC0 ? 0 : tab(p[0]), k = 1;
+	long c = p[0] & (0x7f >> len);
+	if (p[0] < 0x80) return p[0];
+	while (k < len && (p[k] & 0xc0) == 0x80) c = (c << 6) + (p[k++] & 0x3f);
+	return len > 1 && k == len ? c : p[0];
+}
+static size_t m_to16(const uint8_t *s, size_t i)
+{
+	size_t u = 0;
+	for (size_t j = 0, l; j < i; j += l) {
+		l = (size_t)ptr2len_len(s + j, (int)(i - j));
+		u += (l > 1 ? ptr2char(s + j) : s[j]) > 0xFFFF ? 2 : 1;
+	}
+	return u;
+}
+static size_t m_from16(const uint8_t *s, size_t n, size_t u)
+{
+	size_t c = 0;
+	if (u == 0) return 0;
+	for (size_t j = 0, l; j < n; j += l) {
+		l = (size_t)ptr2len_len(s + j, (int)(n - j));
+		c += (l > 1 ? ptr2char(s + j) : s[j]) > 0xFFFF ? 2 : 1;
+		if (c >= u) return j + l;
+	}
+	return n;
+}
