diff --git a/tests/test_uni_u16.c b/tests/test_uni_u16.c
new file mode 100644
index 0000000..d062553
--- /dev/null
+++ b/tests/test_uni_u16.c
@@ -0,0 +1,135 @@
+/* uni_u16 and uni_u16byte against Neovim itself: nvim --headless runs
+   vim.str_utfindex and vim.str_byteindex with 'utf-16' and strict indexing
+   off, as its LSP client calls them, on
+   1. every line of 1 to 4 bytes over 18 bytes that stand for every class
+      utf8len_tab and utf_ptr2char() tell apart (NUL, ASCII, continuation
+      bytes either side of 0x90, leads of 2 to 6 bytes, 0xFE, 0xFF);
+   2. 20,000 random lines of real characters (BMP, astral, U+FFFF and
+      U+10000), overlong and surrogate forms, 5- and 6-byte forms either side
+      of U+FFFF, cut forms, stray continuation bytes, 0xFE and 0xFF.
+   Each line is asked at every byte offset 0..n+1 and every column 0..2n+1
+   (past the end and inside surrogate pairs included). */
+#include <string.h>
+#include "check.h"
+#include "uni.h"
+
+#define LINES 20000
+#define MAXN 48
+
+static const char lua[] =
+	"local f, o = io.open(arg[1] .. '.lines'), io.open(arg[1] .. '.out', 'w')\n"
+	"for h in f:lines() do\n"
+	"  local s = h:gsub('..', function(x) return string.char(tonumber(x, 16)) end)\n"
+	"  local t = {}\n"
+	"  for i = 0, #s + 1 do t[#t + 1] = vim.str_utfindex(s, 'utf-16', i, false) end\n"
+	"  for c = 0, 2 * #s + 1 do t[#t + 1] = vim.str_byteindex(s, 'utf-16', c, false) end\n"
+	"  o:write(table.concat(t, ' '), '\\n')\n"
+	"end\n"
+	"o:close()\n";
+
+static const unsigned char cls[18] = { 0x00, 0x41, 0x80, 0x8F, 0x90, 0xBF, 0xC2, 0xE4, 0xED,
+	0xF0, 0xF4, 0xF7, 0xF8, 0xFB, 0xFC, 0xFD, 0xFE, 0xFF };
+
+static size_t enc(unsigned c, unsigned char *s)
+{
+	if (c < 0x80) { s[0] = (unsigned char)c; return 1; }
+	if (c < 0x800) { s[0] = (unsigned char)(0xC0 + c / 64); s[1] = (unsigned char)(0x80 + c % 64); return 2; }
+	if (c < 0x10000) {
+		s[0] = (unsigned char)(0xE0 + c / 4096); s[1] = (unsigned char)(0x80 + c / 64 % 64);
+		s[2] = (unsigned char)(0x80 + c % 64); return 3;
+	}
+	s[0] = (unsigned char)(0xF0 + c / 262144); s[1] = (unsigned char)(0x80 + c / 4096 % 64);
+	s[2] = (unsigned char)(0x80 + c / 64 % 64); s[3] = (unsigned char)(0x80 + c % 64); return 4;
+}
+
+/* a continuation byte, often one at the edges that decide U+FFFF */
+static unsigned char cont(void)
+{
+	static const unsigned char e[] = { 0x80, 0x8F, 0x90, 0xBF };
+	return (unsigned char)(rnd(2) ? e[rnd(4)] : 0x80 + rnd(0x40));
+}
+
+static size_t line(unsigned char *s)
+{
+	size_t n = 0;
+	while (n < MAXN - 6) {
+		unsigned x = rnd(100);
+		if (x < 8) break;
+		if (x < 25) s[n++] = (unsigned char)"a ~\t1"[rnd(5)];
+		else if (x < 55) {
+			static const unsigned c[] = { 0xE9, 0x7FF, 0x800, 0x4E2D, 0xD7FF, 0xE000, 0xFFFF, 0x10000,
+				0x1F600, 0x10FFFF, 0x110000, 0x1FFFFF };
+			n += enc(rnd(3) ? c[rnd(12)] : 0x80 + rnd(0x200000 - 0x80), s + n);
+		} else if (x < 75) {   /* a 2- to 6-byte form, any lead of its length, often overlong */
+			static const unsigned char lo[] = { 0xC0, 0xE0, 0xF0, 0xF8, 0xFC }, hi[] = { 0x20, 0x10, 0x8, 0x4, 0x2 };
+			unsigned k = rnd(5);
+			s[n] = (unsigned char)(lo[k] + (rnd(2) ? 0 : rnd(hi[k])));
+			for (unsigned j = 1; j <= k + 1; j++) s[n + j] = rnd(4) ? 0x80 : cont();
+			n += k + 2;
+		} else if (x < 88) {   /* a form cut short, or broken by a non-continuation byte */
+			unsigned char t[4];
+			size_t k = enc(0x80 + rnd(0x200000 - 0x80), t), m = 1 + rnd((unsigned)k - 1);
+			memcpy(s + n, t, m);
+			n += m;
+			if (rnd(2)) s[n++] = (unsigned char)(rnd(2) ? 'x' : 0xC3);
+		} else if (x < 96) s[n++] = cont();
+		else s[n++] = (unsigned char)"\xfe\xff\x00"[rnd(3)];
+	}
+	return n;
+}
+
+static unsigned char lines[111150 + LINES][MAXN];
+static size_t len[111150 + LINES];
+
+int main(void)
+{
+	int m = 0;
+	for (int k = 1; k <= 4; k++) {
+		int total = 1;
+		for (int j = 0; j < k; j++) total *= 18;
+		for (int v = 0; v < total; v++, m++) {
+			for (int j = 0, w = v; j < k; j++, w /= 18) lines[m][j] = cls[w % 18];
+			len[m] = (size_t)k;
+		}
+	}
+	int exhaustive = m;
+	for (int r = 0; r < LINES; r++, m++) len[m] = line(lines[m]);
+
+	FILE *f = fopen("build/uni_u16.lines", "w");
+	CHECK(f);
+	for (int r = 0; r < m; r++) {
+		for (size_t j = 0; j < len[r]; j++) fprintf(f, "%02x", lines[r][j]);
+		fputc('\n', f);
+	}
+	fclose(f);
+	f = fopen("build/uni_u16.lua", "w");
+	CHECK(f && fputs(lua, f) >= 0);
+	fclose(f);
+	CHECK(system("nvim --clean --headless -l build/uni_u16.lua build/uni_u16") == 0);
+
+	f = fopen("build/uni_u16.out", "r");
+	CHECK(f);
+	unsigned long asks = 0;
+	for (int r = 0; r < m; r++) {
+		const unsigned char *s = lines[r];
+		size_t n = len[r];
+		unsigned long want;
+		for (size_t i = 0; i <= n + 1; i++, asks++) {
+			CHECK(fscanf(f, "%lu", &want) == 1);
+			if (want != uni_u16(s, n, i)) fprintf(stderr, "line %d: uni_u16 at %zu: %zu, nvim %lu\n", r + 1, i, uni_u16(s, n, i), want);
+			CHECK(want == uni_u16(s, n, i));
+		}
+		for (size_t c = 0; c <= 2 * n + 1; c++, asks++) {
+			CHECK(fscanf(f, "%lu", &want) == 1);
+			if (want != uni_u16byte(s, n, c)) fprintf(stderr, "line %d: uni_u16byte at %zu: %zu, nvim %lu\n", r + 1, c, uni_u16byte(s, n, c), want);
+			CHECK(want == uni_u16byte(s, n, c));
+		}
+	}
+	int c;
+	while ((c = fgetc(f)) == '\n' || c == ' ') {}
+	CHECK(c == EOF);
+	fclose(f);
+	printf("test_uni_u16: %d lines of 1-4 bytes exhaustive over 18 byte classes, %d random lines, %lu answers equal Neovim's\n",
+	       exhaustive, LINES, asks);
+	return 0;
+}
